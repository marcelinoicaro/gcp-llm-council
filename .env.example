# Google Cloud project with the Vertex AI API enabled (see infra/terraform)
GCP_PROJECT_ID=my-gcp-project
# Default Vertex AI location ("global" recommended)
GCP_LOCATION=global
# Recommended: call Vertex AI as the app's service account (see infra/terraform output env_snippet)
# GCP_IMPERSONATE_SERVICE_ACCOUNT=llm-council@my-gcp-project.iam.gserviceaccount.com

# Optional: council composition ("publisher/model[@location]", comma-separated)
# COUNCIL_MODELS=anthropic/claude-opus-5-5,openai/gpt-oss-120b-maas,deepseek-ai/deepseek-v4.1-flash-1017-maas,zai-org/glm-5.2-maas,google/gemini-4-argon,google/gemini-4-carbon,google/gemini-4-hydrogen,google/gemini-4-neon,google/gemini-3.8-flash,google/gemini-3.5-flash-lite
# CHAIRMAN_MODEL=google/gemini-4-hydrogen
# TITLE_MODEL=google/gemini-3.8-flash
# MODEL_TIMEOUT_SECONDS=600

# Optional: security limits
# MAX_MESSAGE_CHARS=20000
# MAX_MESSAGES_PER_MINUTE=5
